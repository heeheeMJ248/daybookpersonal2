(()=>{const shared=location.pathname.includes('daybook-share');const prefix=shared?'daybook-share-top-goals-v1':'daybook-top-goals-v1';const month=new Date(),key=prefix+':'+month.getFullYear()+'-'+String(month.getMonth()+1).padStart(2,'0'),title=document.getElementById('topGoalsMonth'),fields=[...document.querySelectorAll('[data-month-goal]')];if(!fields.length)return;if(title)title.textContent=month.toLocaleDateString(undefined,{month:'long',year:'numeric'});let saved={};try{saved=JSON.parse(localStorage.getItem(key)||'{}')||{}}catch{}fields.forEach((field,i)=>{field.value=saved[i]||'';field.addEventListener('input',()=>{saved[i]=field.value;localStorage.setItem(key,JSON.stringify(saved))})})})();
</script>
