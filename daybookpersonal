function trainerReply(message){let m=message.toLowerCase(),week=workouts.filter(w=>w.date>=workoutWeekStart()&&w.date<=plus(workoutWeekStart(),6)),total=week.length,mins=week.reduce((n,w)=>n+(Number(w.minutes)||0),0);if(/pain|hurt|injur|dizzy|sick/.test(m))return 'Blunt answer: don’t train through pain, dizziness, or feeling sick. Stop, rest, and get qualified help if it persists or feels serious. Missing one workout is better than making things worse.';if(/miss|skip|behind|guilt|lazy/.test(m))return `You missed a workout. That’s a fact, not a character flaw. Don’t punish yourself with a double session. Pick the next realistic day and do the smallest version—ten minutes is enough to restart.`;if(/motivat|can't start|cant start|procrastinat/.test(m))return 'You don’t need to feel motivated first. Put on what you need, start a five-minute warm-up, then decide whether to continue. No bargaining for a perfect mood.';if(/today|pick|choose|what.*do|workout idea/.test(m))return 'Choose based on your energy, not your guilt: feeling good—do your planned workout; low energy—take an easy walk or mobility break; exhausted or unwell—rest. Pick one and keep it simple.';if(/goal|target|progress|week|how am i/.test(m))return `This week you’ve logged ${total} session${total===1?'':'s'} and ${mins} minutes against your ${workoutTarget}-session target. ${total>=workoutTarget?'You met the target. Keep recovery in the plan.':'You have '+Math.max(0,workoutTarget-total)+' session'+(workoutTarget-total===1?'':'s')+' left. Make the next one realistic, not heroic.'}`;return `Here’s the straight answer: make the plan small enough that you’ll actually do it. You’ve logged ${total} session${total===1?'':'s'} this week. Tell me your energy level, time available, or what’s blocking you, and I’ll help you choose a sensible next step.`}
