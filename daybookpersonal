ion value="celestial">Celestial</option><option value="bookish">Bookish</option><option value="cozy">Cozy</option></select></label><label>Logo color<input id="brandLogoColor" type="color" value="#4b3328" aria-label="Logo icon color"></label><label>Bubble color<input id="brandBubbleColor" type="color" value="#efe3ef" aria-label="Logo bubble color"></label></div></section>
