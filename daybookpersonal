ne);border-radius:11px;background:color-mix(in srgb,var(--soft) 42%,var(--card))}.fitness-progress-columns h3{margin:0 0 8px;font-size:11px;color:var(--green)}.fitness-achieved-item{display:flex;gap:7px;padding:7px 0;border-top:1px solid var(--line)}.fitness-achieved-item>span{color:var(--green);font-weight:800}.fitness-achieved-item strong,.fitness-achieved-item small,.fitness-next-item strong,.fitness-next-item small{display:block}.fitness-achieved-item strong,.fitness-next-item strong{font-size:9px;line-height:1.4}.fitness-achieved-item small,.fitness-next-item small{margin-top:3px;font-size:8px;color:var(--muted)}.fitness-progress-empty{font-size:9px;color:var(--muted);line-height:1.45;margin:6px 0}.fitness-progress-current details summary{display:grid;grid-template-columns:1fr auto;gap:5px;align-items:center;cursor:pointer;list-style:none;font-size:11px;font-weight:700;color:var(--green)}.fitness-progress-current details summary::-webkit-details-marker{display:none}.fitness-progress-current details summary small{grid-column:1/-1;font-size:8px;font-weight:400;color:var(--muted)}.fitness-progress-track{height:7px;grid-column:1/-1;overflow:hidden;border-radius:8px;background:var(--line)}.fitness-progress-track i{display:block;width:0;height:100%;border-radius:inherit;background:var(--green);transition:width .25s}.fitness-next-item{padding:8px 0;border-top:1px solid var(--line)}.fitness-next-item ol{margin:6px 0 0;padding-left:18px}.fitness-next-item li{padding:2px 0;font-size:8px;line-height:1.4;color:var(--ink)}@media(max-width:800px){.fitness-progress-columns{grid-template-columns:1fr 1fr}}@media(max-width:480px){.fitness-progress-columns{grid-template-columns:1fr}}</style></head><body data-theme="espresso"><div class="shell">
